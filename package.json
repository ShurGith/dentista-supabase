{
  "name": "clinica-dental-eugenia-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema integral de gestión de citas, pacientes y WhatsApp (Wawp) para Clínica Dental Eugenia (Sin módulos de pago)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace=apps/api run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "dev:mobile": "npm --workspace=apps/mobile start",
    "build:shared": "npm --workspace=packages/shared run build",
    "build:api": "npm --workspace=apps/api run build",
    "build:web": "npm --workspace=apps/web run build",
    "test": "npm --workspace=apps/api run test",
    "db:migrate": "node apps/api/scripts/apply-migrations.js",
    "db:seed": "node apps/api/scripts/seed-data.js"
  },
  "keywords": [
    "dental-clinic",
    "appointment-management",
    "supabase",
    "wawp",
    "whatsapp",
    "fullcalendar"
  ],
  "author": "Equipo Senior de Producto y Arquitectura",
  "license": "UNLICENSED",
  "dependencies": {
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/list": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "@supabase/supabase-js": "^2.119.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "lucide-react": "^1.76.0",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  }
}
